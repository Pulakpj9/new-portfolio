# Client: Supabase project URL (safe to expose; RLS denies direct access anyway).
NEXT_PUBLIC_SUPABASE_URL=
# Client: anon key (safe to expose; RLS denies direct access anyway).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server ONLY: bypasses RLS. Never prefix with NEXT_PUBLIC_. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Set to "true" to disable tracking (preview deploys, local debugging).
# NEXT_PUBLIC_ANALYTICS_DISABLED=true

# Production: comma-separated hosts allowed to submit analytics
# (prevents preview/localhost traffic polluting prod stats).
# Unset = accept all (fine for dev).
# ANALYTICS_ALLOWED_HOSTS=example.com,www.example.com

# Chat (Phase A): OpenAI-compatible LLM for Pulak Mini.
# Recommended: Gemini Flash (generous free tier via Google AI Studio).
#   1. Get a key: https://aistudio.google.com → Get API Key
#   2. Restrict it to the "Generative Language API" (API restrictions tab)
#   3. Set the three vars below (CHAT_API_KEY + CHAT_API_URL + CHAT_MODEL)
# Unset = chat runs in offline regex-fallback mode (still functional).
# CHAT_API_KEY=AIza...
# CHAT_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# CHAT_MODEL=gemini-2.5-flash
# Alternatives (same three vars, different values):
#   OpenAI:      CHAT_API_URL=https://api.openai.com/v1  + CHAT_MODEL=gpt-4o-mini
#   OpenRouter:  CHAT_API_URL=https://openrouter.ai/api/v1 + CHAT_MODEL=<any-flash-class-model>
